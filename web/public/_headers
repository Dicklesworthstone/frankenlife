# Cloudflare's static-asset headers (Workers assets read this file from out/).
# The film and Next's build output are named by their content, so they never change in place.
/media/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
