{
  "name": "frankenlife-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "npm": "DO NOT USE NPM - Use bun instead",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "media": "bun scripts/media.ts",
    "media:4k60": "bun scripts/media.ts --ticks 3200 --every 4 --width 2160 --height 2160 --fps 60 --crf 19 --segments auto --segment-max-mib 22",
    "controls:4k": "bun scripts/controls.ts --size 2160",
    "check-media": "bun scripts/check-media.ts",
    "check-film-words": "bun scripts/check-film-words.ts",
    "build": "bun scripts/check-media.ts && bun scripts/check-film-words.ts && next build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.162.0"
  }
}
