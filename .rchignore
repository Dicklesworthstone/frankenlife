worlds/
checkpoints/
chunks/
out/
exports/
media/
recordings/
frames/
reference_images/
*.mp4
*.mov
*.mkv
*.webm
*.gif
*.y4m
*.wav
IMG_*.jpeg
IMG_*.jpg
IMG_*.png
.env
.env.*
