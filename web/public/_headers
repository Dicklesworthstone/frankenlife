# Cloudflare's static-asset headers (Workers assets read this file from out/).
# The posters, cards, stills and Next's build output are named by their content, so they never change in
# place. (The films are not static assets: worker.ts serves them from R2, with its own headers.)
/media/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
