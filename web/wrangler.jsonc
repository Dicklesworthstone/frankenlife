{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The static export in `out/` (`bun run build`), served as Workers static
  // assets. Only /media/* runs worker.ts first: static assets ignore Range
  // requests, and Safari plays no video without them.
  "name": "frankenlife",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
