{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The static export in `out/` (`bun run build`), served as Workers static
  // assets at frankenlife.org, and the films, one MP4 each, in the R2 bucket
  // frankenlife-media (scripts/upload-media.ts). worker.ts runs first: it
  // sends www. to the apex and serves the films' byte ranges from R2 (Safari
  // plays no video without them); everything else goes straight to the assets.
  "name": "frankenlife",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "frankenlife.org", "custom_domain": true },
    { "pattern": "www.frankenlife.org", "custom_domain": true }
  ],
  // `remote`: `wrangler dev` (`bun run preview`) reads the films from the real bucket, which the Worker only
  // reads; a local bucket would be empty. A deploy ignores it.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "frankenlife-media", "remote": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
